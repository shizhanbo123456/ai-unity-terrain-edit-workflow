/* AiTerrainWorkflow 备用最小运行时主题（DefaultRuntimeTheme.tss）
 *
 * 用途：当无法从 Unity 内置包加载默认运行时主题时（如内置主题路径变化），
 * 作为 PanelSettings.themeStyleSheet 的兜底，保证 UI 不至于空白渲染。
 * 语法与 USS 一致（.tss 由 Unity 导入为 ThemeStyleSheet 资产）。
 */

Label {
    color: rgba(255, 255, 255, 0.92);
}

Button {
    background-color: rgb(45, 92, 140);
    color: rgb(255, 255, 255);
    border-radius: 4px;
    padding: 4px 8px;
}

Button:hover {
    background-color: rgb(60, 120, 180);
}

TextField, DropdownField {
    color: rgb(255, 255, 255);
}

TextField .unity-text-element--input,
DropdownField .unity-base-field__input {
    background-color: rgb(30, 30, 42);
}

Toggle {
    color: rgb(255, 255, 255);
}

ListView {
    background-color: rgb(20, 20, 30);
}

ListView .unity-collection-view__item {
    background-color: rgb(28, 28, 40);
}

ProgressBar {
    background-color: rgb(40, 40, 54);
}

ProgressBar .unity-progress-bar__progress {
    background-color: rgb(70, 140, 90);
}
