/* AiTerrainWorkflow Gui 测试样式（TestStyle.uss） */

.test-root {
    flex-grow: 1;
    padding: 16px;
    background-color: rgb(20, 24, 32);
}

.test-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 10px;
}

.test-btn {
    width: 200px;
    height: 28px;
    background-color: rgb(40, 120, 200);
    color: rgb(255, 255, 255);
    border-radius: 4px;
    margin-bottom: 8px;
}

.test-btn:hover {
    background-color: rgb(60, 150, 230);
}

.test-btn:active {
    background-color: rgb(30, 90, 160);
}

.test-box {
    width: 140px;
    height: 90px;
    background-color: rgba(80, 200, 120, 0.45);
    border-radius: 8px;
    margin-top: 12px;
}
